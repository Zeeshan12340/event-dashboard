# PredictHQ API key used by the server-side routes in src/app/api/events.
# IMPORTANT: this is read on the server only — do NOT prefix it with
# NEXT_PUBLIC_, which would expose the key to the browser.
#
# When this is left unset, the app serves the bundled sample data from
# src/app/results.json instead of calling PredictHQ.
PREDICTHQ_API_KEY=
